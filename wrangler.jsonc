{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gomultan",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gomultan"
    }
  ],
  // Resizes next/image requests. Free plan: 5,000 unique transformations a month.
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
  // When the real store is built, add an R2 bucket here for product images and the page cache:
  // "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "gomultan-cache" }]
}
